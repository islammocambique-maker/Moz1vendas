/* ==========================================================
   NETSHOP — DEPÓSITO
   ========================================================== */

function processarDepositoNetshop(
  refCliente,
  telefone,
  valor,
  metodo
) {

  try {

    if (!refCliente)
      throw new Error(
        'Referencia obrigatória.'
      );


    if (
      !valor ||
      Number(valor) <= 0
    )
      throw new Error(
        'Valor deve ser maior que zero.'
      );


    if (!telefone)
      throw new Error(
        'Telefone obrigatório.'
      );


    let telFormatado =
      String(telefone)
        .trim()
        .replace(/\s+/g, '');


    if (
      !telFormatado.startsWith('+258')
    ) {

      if (
        telFormatado.startsWith('258')
      ) {

        telFormatado =
          '+' +
          telFormatado;

      } else {

        telFormatado =
          '+258' +
          telFormatado;

      }

    }


    const payload = {

      amount:
        Number(valor),

      currency:
        'MZN',

      method:
        metodo || 'mpesa',

      msisdn:
        telFormatado,

      reference:
        refCliente,

      metadata: {

        cliente_ref:
          refCliente,

        origem:
          'SORTEMZ_APP'

      }

    };


    const options = {

      method:
        'post',

      contentType:
        'application/json',

      headers: {

        'Authorization':
          'Bearer ' +
          NETSHOP_CONFIG.API_KEY,

        'X-Wallet-ID':
          NETSHOP_CONFIG.WALLET_ID

      },

      payload:
        JSON.stringify(payload),

      muteHttpExceptions:
        true

    };


    const response =
      UrlFetchApp.fetch(
        NETSHOP_CONFIG.BASE_URL +
        '/charges',
        options
      );


    const statusCode =
      response.getResponseCode();


    const responseText =
      response.getContentText();


    if (
      statusCode < 200 ||
      statusCode >= 300
    ) {

      let erroMsg =
        'Erro ' +
        statusCode +
        ' na NetShop';


      try {

        const erroJson =
          JSON.parse(
            responseText
          );


        erroMsg =
          erroJson.message ||
          erroJson.error ||
          erroMsg;

      } catch (e) {

        erroMsg =
          responseText.substring(
            0,
            200
          ) ||
          erroMsg;

      }


      return {

        success: false,

        message:
          erroMsg,

        httpStatus:
          statusCode

      };

    }


    const resJson =
      JSON.parse(
        responseText
      );


    if (
      resJson.status ===
      'paid'
    ) {

      const creditado =
        creditarSaldoPorReferencia(
          refCliente,
          Number(valor)
        );


      if (!creditado.encontrado) {

        throw new Error(
          'Referencia ' +
          refCliente +
          ' não encontrada.'
        );

      }


      return {

        success: true,

        status:
          'paid',

        message:
          'Pagamento efetuado com sucesso!'

      };

    }


    if (
      resJson.status ===
      'pending'
    ) {

      return {

        success: true,

        status:
          'pending',

        charge_id:
          resJson.id,

        message:
          'Confirme a transação no seu celular.'

      };

    }


    if (
      resJson.status ===
      'failed'
    ) {

      return {

        success: false,

        message:
          resJson.failed_reason ||
          resJson.message ||
          'Pagamento recusado.'

      };

    }


    return {

      success: false,

      message:
        resJson.message ||
        'Resposta inesperada da NetShop.',

      status:
        resJson.status

    };


  } catch (error) {

    Logger.log(
      'Erro NetShop: ' +
      error.toString()
    );


    return {

      success: false,

      message:
        'Erro: ' +
        error.toString()

    };

  }

}


/* ==========================================================
   WEBHOOK NETSHOP
   ========================================================== */

function processarWebhookNetshop(
  data
) {

  try {

    const evento =
      data.event || '';


    const status =
      data.status ||
      (
        data.data &&
        data.data.status
      ) ||
      '';


    if (
      evento !==
        'charge.paid' &&
      status !==
        'paid'
    ) {

      return {

        success: true,

        message:
          'Evento ignorado: ' +
          evento

      };

    }


    const referencia =
      (
        data.reference ||
        (
          data.data &&
          data.data.reference
        ) ||
        ''
      )
      .toString()
      .trim()
      .toUpperCase();


    const valor =
      Number(
        data.amount ||
        (
          data.data &&
          data.data.amount
        ) ||
        0
      );


    const transacaoId =
      (
        data.id ||
        (
          data.data &&
          data.data.id
        ) ||
        'NET-' +
        Date.now()
      ).toString();


    if (!referencia)
      throw new Error(
        'Referencia obrigatória no webhook.'
      );


    if (!valor || valor <= 0)
      throw new Error(
        'Valor inválido no webhook.'
      );


    if (
      !referencia.startsWith('SMZ')
    )
      throw new Error(
        'Referencia inválida.'
      );


    const ss =
      SpreadsheetApp.openById(
        SPREADSHEET_ID
      );


    const sheetMovimentos =
      ss.getSheetByName(
        SHEETS.MOVIMENTOS
      );


    const movs =
      sheetMovimentos
        .getDataRange()
        .getValues();


    /*
     * EVITAR DUPLICAÇÃO
     */

    for (
      let i = 1;
      i < movs.length;
      i++
    ) {

      if (
        String(
          movs[i][7] || ''
        ) ===
        transacaoId
      ) {

        return {

          success: true,

          message:
            'Transação já processada.',

          duplicado: true

        };

      }

    }


    const resultado =
      creditarSaldoPorReferencia(
        referencia,
        valor
      );


    if (!resultado.encontrado)
      throw new Error(
        'Referencia ' +
        referencia +
        ' não encontrada.'
      );


    const movId =
      'MOV-' +
      Utilities
        .getUuid()
        .substring(0, 8)
        .toUpperCase();


    sheetMovimentos.appendRow([

      movId,

      new Date(),

      resultado.usuarioId,

      'DEPOSITO',

      referencia,

      valor,

      'CONFIRMADO',

      transacaoId,

      'Netshop'

    ]);


    return {

      success: true,

      message:
        'Depósito creditado.',

      referencia:
        referencia,

      transacaoId:
        transacaoId

    };


  } catch (err) {

    Logger.log(
      'Erro webhook: ' +
      err.toString()
    );


    return {

      success: false,

      message:
        err.toString()

    };

  }

}


/* ==========================================================
   CREDITAR SALDO POR REFERÊNCIA
   ========================================================== */

function creditarSaldoPorReferencia(
  refCliente,
  valor
) {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const abaUsuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const dados =
    abaUsuarios
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    const refPlanilha =
      String(
        dados[i][4] || ''
      )
      .trim()
      .toUpperCase();


    if (
      refPlanilha ===
      String(refCliente)
        .trim()
        .toUpperCase()
    ) {

      const saldoAtual =
        Number(
          dados[i][5]
        ) || 0;


      abaUsuarios
        .getRange(
          i + 1,
          6
        )
        .setValue(
          saldoAtual +
          Number(valor)
        );


      return {

        encontrado: true,

        usuarioId:
          dados[i][0],

        saldoAnterior:
          saldoAtual

      };

    }

  }


  return {

    encontrado: false

  };

}


