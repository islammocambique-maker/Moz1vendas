            s.data,
            s.hora
          );


        if (!dataHora) {

          return false;
        }


        const fechamento =
          new Date(
            dataHora.getTime() -
            MINUTOS_FECHAMENTO_ANTES *
            60000
          );


        return agora < fechamento;

      })
