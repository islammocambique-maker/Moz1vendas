/* ==========================================================
   GET
   ========================================================== */

function doGet(e) {

  try {

    const action =
      e &&
      e.parameter &&
      e.parameter.action
        ? e.parameter.action
        : '';

    switch (action) {

      case 'config':
        return jsonResponse(obterConfig());

      case 'sorteiosAbertos':
        return jsonResponse(obterSorteiosAbertos());

      case 'resultado':
        return jsonResponse(obterUltimoResultado());

      case 'usuario':
        return jsonResponse(
          obterUsuario(
            e.parameter.id
          )
        );

      case 'minhasJogadas':
        return jsonResponse(
          obterMinhasJogadas(
            e.parameter.id
          )
        );

      case 'meusPremios':
        return jsonResponse(
          obterMeusPremios(
            e.parameter.id
          )
        );

      case 'meusLevantamentos':
        return jsonResponse(
          obterMeusLevantamentos(
            e.parameter.id
          )
        );

      default:

        return jsonResponse({

          success: true,

          sistema: CONFIG.NOME,

          jogo: CONFIG.JOGO,

          mensagem: 'SORTEMZ API ativa.'

        });

    }

  } catch (erro) {

    return jsonResponse({

      success: false,

      error: erro.toString()

    });

  }

}


/* ==========================================================
   POST
   ========================================================== */

function doPost(e) {

  try {

    const p =
      e &&
      e.parameter
        ? e.parameter
        : {};

    const action = p.action || '';

    switch (action) {

      case 'registarUsuario':

        return jsonResponse(
          registarUsuario(
            p.nome,
            p.telefone
          )
        );


      case 'registarJogada':

        return jsonResponse(
          registarJogada(
            p.usuarioId,
            p.referencia,
            p.sorteioId,
            p.numeros,
            p.valor
          )
        );


      case 'depositoNetshop':

        return jsonResponse(
          processarDepositoNetshop(
            p.referencia,
            p.telefone,
            p.valor,
            p.metodo
          )
        );


      case 'solicitarLevantamento':

        return jsonResponse(
          solicitarLevantamento(
            p.usuarioId,
            p.valor,
            p.telefone
          )
        );


      case 'webhookNetshop':

        return jsonResponse(
          processarWebhookNetshop(
            interpretarWebhook(p)
          )
        );


      default:

        return jsonResponse({

          success: false,

          error: 'Ação não reconhecida.'

        });

    }

  } catch (erro) {

    return jsonResponse({

      success: false,

      error: erro.toString()

    });

  }

}


/* ==========================================================
   RESPOSTA JSON
   ========================================================== */

function jsonResponse(obj) {

  return ContentService

    .createTextOutput(
      JSON.stringify(obj)
    )

    .setMimeType(
      ContentService.MimeType.JSON
    );

}


