function criarSorteiosDia(dataBase) {

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);

  const sheet = ss.getSheetByName(SHEETS.SORTEIOS);

  if (!sheet) {
    throw new Error('Aba SORTEIOS não existe.');
  }


  const dataAlvo = dataParaString(dataBase);

  const dados = sheet.getDataRange().getValues();

  const existentes = {};


  // Lê todos os sorteios existentes
  for (let i = 1; i < dados.length; i++) {

    const dataLinha = dataParaString(dados[i][1]);

    const horaLinha = normalizarHora(dados[i][2]);

    if (dataLinha === dataAlvo && horaLinha) {

      existentes[horaLinha] = true;
    }
  }


  // Cria individualmente os horários que estiverem faltando
  HORARIOS_SORTEIO.forEach(function(hora) {

    if (!existentes[hora]) {

      const id =
        'SRT-' +
        Utilities
          .getUuid()
          .substring(0, 6)
          .toUpperCase();


      const dataReal = criarDataHora(
        dataAlvo,
        '00:00'
      );


      sheet.appendRow([
        id,
        dataReal,
        hora,
        0,
        0,
        0,
        0,
        0,
        'ABERTO'
      ]);

      Logger.log(
        'Sorteio criado: ' +
        dataAlvo +
        ' ' +
        hora
      );
    }
  });


  SpreadsheetApp.flush();
}


// ============================================================
// FECHAMENTO AUTOMÁTICO
// ============================================================

function triggerFecharSorteios() {

  try {

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName(SHEETS.SORTEIOS);

    if (!sheet) {
      throw new Error('Aba SORTEIOS não encontrada.');
    }

    const dados = sheet.getDataRange().getValues();
    const agora = new Date();

    for (let i = 1; i < dados.length; i++) {

      const id = String(dados[i][0] || '').trim();
      const data = dados[i][1];
      const hora = dados[i][2];

      if (!id || !data || !hora) {
        continue;
      }

      const dataHoraSorteio =
        criarDataHora(data, hora);

      if (!dataHoraSorteio) {
        continue;
      }

      // Fecha 15 minutos antes do sorteio
      const fechamento =
        new Date(
          dataHoraSorteio.getTime() -
          MINUTOS_FECHAMENTO_ANTES * 60000
        );

      const statusAtual =
        normalizarStatus(dados[i][8]);

      // =====================================================
      // AINDA ESTÁ DENTRO DO PERÍODO DE APOSTAS
      // =====================================================

      if (agora < fechamento) {

        if (statusAtual !== 'ABERTO') {

          sheet
            .getRange(i + 1, 9)
            .setValue('ABERTO');

          Logger.log(
            'Sorteio ABERTO: ' +
            id +
            ' | ' +
            dataParaString(data) +
            ' ' +
            normalizarHora(hora)
          );
        }

        continue;
      }

      // =====================================================
      // JÁ CHEGOU AOS 15 MINUTOS ANTES
      // =====================================================

      if (
        agora >= fechamento &&
        agora < dataHoraSorteio &&
        statusAtual === 'ABERTO'
      ) {

        sheet
          .getRange(i + 1, 9)
          .setValue('FECHADO');

        Logger.log(
          'Sorteio FECHADO: ' +
          id
        );
      }
    }

    SpreadsheetApp.flush();

  } catch (e) {

    Logger.log(
      'ERRO triggerFecharSorteios: ' +
      e.message
    );
  }
}


// ============================================================
// SORTEIO AUTOMÁTICO
// ============================================================

function triggerSorteioAutomatico() {

  try {

    const ss =
      SpreadsheetApp.openById(SPREADSHEET_ID);

    const sheet =
      ss.getSheetByName(SHEETS.SORTEIOS);

    if (!sheet) return;


    const dados =
      sheet.getDataRange().getValues();

    const agora = new Date();

    let sorteados = 0;


    for (let i = 1; i < dados.length; i++) {

      const status =
        normalizarStatus(dados[i][8]);

      if (status !== 'FECHADO') {
        continue;
      }


      const sorteioId =
        String(dados[i][0] || '').trim();

      if (!sorteioId) continue;


      const dataHoraSorteio =
        criarDataHora(
          dados[i][1],
          dados[i][2]
        );

      if (!dataHoraSorteio) continue;


      if (
        agora >= dataHoraSorteio &&
        !resultadoExiste(sorteioId)
      ) {

        try {

          processarSorteioCompleto(
            sorteioId
          );

          sorteados++;

        } catch (erroSorteio) {

          Logger.log(
            'Erro no sorteio ' +
            sorteioId +
            ': ' +
            erroSorteio.message
          );
        }
      }
    }


    if (sorteados > 0) {

      Logger.log(
        'Sorteios processados: ' +
        sorteados
      );
    }

  } catch (e) {

    Logger.log(
      'ERRO triggerSorteioAutomatico: ' +
      e.message
    );
  }
}


