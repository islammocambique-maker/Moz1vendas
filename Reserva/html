  valor =
    Number(valor);


  if (
    valor < 50
  ) {

    throw new Error(
      'Valor mínimo para levantamento: 50 MZN.'
    );

  }


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const usuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );

