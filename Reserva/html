/* ==========================================================
   UTILITÁRIOS
   ========================================================== */

function normalizarTelefone(
  telefone
) {

  let t =
    String(
      telefone || ''
    )
    .trim()
    .replace(/\D/g, '');


  if (
    t.startsWith('258') &&
    t.length > 9
  ) {

    t =
      t.substring(3);

  }


  return t;

}


function normalizarNumeros(
  numeros
) {

  if (
    Array.isArray(numeros)
  ) {

    return numeros
      .map(Number)
      .filter(
        n =>
          Number.isInteger(n) &&
          n >= 1 &&
          n <= 55
      )
      .filter(
        (n, i, arr) =>
          arr.indexOf(n) === i
      )
      .sort(
        (a, b) => a - b
      );

  }


  return String(
    numeros || ''
  )
    .split(',')
    .map(
      x => Number(
        String(x).trim()
      )
    )
    .filter(
      n =>
        Number.isInteger(n) &&
        n >= 1 &&
        n <= 55
    )
    .filter(
      (n, i, arr) =>
        arr.indexOf(n) === i
    )
    .sort(
      (a, b) => a - b
    );

}


function calcularDataHora(
  data,
  hora
) {

  const partesData =
    String(data)
      .split('-')
      .map(Number);


  const partesHora =
    String(hora)
      .split(':')
      .map(Number);


  return new Date(

    partesData[0],

    partesData[1] - 1,

    partesData[2],

    partesHora[0] || 0,

    partesHora[1] || 0,

    0

  );

}


function formatarDataHora(
  data
) {

  return Utilities.formatDate(

    new Date(data),

    Session.getScriptTimeZone(),

    'yyyy-MM-dd HH:mm:ss'

  );

}


function formatarData(
  data
) {

  if (!data)
    return '';


  return Utilities.formatDate(

    new Date(data),

    Session.getScriptTimeZone(),

    'dd/MM/yyyy HH:mm'

  );

}


