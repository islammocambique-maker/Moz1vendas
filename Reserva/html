function resultadoExiste(sorteioId) {

  const ss =
    SpreadsheetApp.openById(SPREADSHEET_ID);

  const sheet =
    ss.getSheetByName(SHEETS.RESULTADOS);

  if (!sheet) return false;


  const dados =
    sheet.getDataRange().getValues();


  for (let i = 1; i < dados.length; i++) {

    if (
      String(dados[i][0]).trim() ===
      String(sorteioId).trim()
    ) {
      return true;
    }
  }

  return false;
}


// ============================================================
// PROCESSAR SORTEIO COMPLETO
// ============================================================

function processarSorteioCompleto(sorteioId) {

  const ss =
    SpreadsheetApp.openById(SPREADSHEET_ID);

  const sheetSorteios =
    ss.getSheetByName(SHEETS.SORTEIOS);

  const sheetResultados =
    ss.getSheetByName(SHEETS.RESULTADOS);

  const sheetJogadas =
    ss.getSheetByName(SHEETS.JOGADAS);

  const sheetPremios =
    ss.getSheetByName(SHEETS.PREMIOS);

  const sheetUsuarios =
    ss.getSheetByName(SHEETS.USUARIOS);

  const sheetMovimentos =
    ss.getSheetByName(SHEETS.MOVIMENTOS);


  const dadosSorteios =
    sheetSorteios.getDataRange().getValues();


  let linhaSorteio = -1;
  let fundoPremios = 0;


  for (let i = 1; i < dadosSorteios.length; i++) {

    if (
      String(dadosSorteios[i][0]).trim() ===
      String(sorteioId).trim()
    ) {

      linhaSorteio = i + 1;

      fundoPremios =
        Number(dadosSorteios[i][5] || 0);

      break;
    }
  }


  if (linhaSorteio === -1) {

    throw new Error(
      'Sorteio não encontrado.'
    );
  }


  if (resultadoExiste(sorteioId)) {

    throw new Error(
      'Este sorteio já possui resultado.'
    );
  }


  // ==========================================================
  // BUSCAR JOGADAS
  // ==========================================================

  const dadosJogadas =
    sheetJogadas.getDataRange().getValues();

  const jogadasDoSorteio = [];

  const todosNumerosApostados =
    new Set();


  for (let i = 1; i < dadosJogadas.length; i++) {

    const idJogadaSorteio =
      String(dadosJogadas[i][3] || '').trim();

    const status =
      normalizarStatus(dadosJogadas[i][8]);


    if (
      idJogadaSorteio ===
      String(sorteioId).trim() &&
      status === 'CONFIRMADA'
    ) {

      const textoNumeros =
        String(dadosJogadas[i][6] || '');

      const nums =
        textoNumeros
          .split(',')
          .map(Number)
          .filter(function(n) {
            return n >= 1 && n <= 55;
          });


      if (nums.length === 5) {

        jogadasDoSorteio.push({

          linha: i + 1,

          usuarioId:
            dadosJogadas[i][1],

          jogadaId:
            dadosJogadas[i][0],

          numeros:
            nums,

          valor:
            Number(dadosJogadas[i][7] || 0)
        });


        nums.forEach(function(n) {

          todosNumerosApostados.add(n);

        });
      }
    }
  }


  // ==========================================================
  // GERAR NÚMEROS
  // ==========================================================

  let numerosSorteados;


  if (jogadasDoSorteio.length === 0) {

    numerosSorteados =
      gerarCombinacaoAleatoria();

    Logger.log(
      'Sorteio ' +
      sorteioId +
      ': sem apostas.'
    );

  } else {

    numerosSorteados =
      sorteioCondicionado(
        jogadasDoSorteio,
        fundoPremios,
        todosNumerosApostados
      );

    Logger.log(
      'Sorteio ' +
      sorteioId +
      ': ' +
      numerosSorteados.join(',')
    );
  }


  // ==========================================================
  // GRAVAR RESULTADO
  // ==========================================================

  sheetResultados.appendRow([

    sorteioId,

    new Date(),

    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      'HH:mm:ss'
    ),

    numerosSorteados[0],
    numerosSorteados[1],
    numerosSorteados[2],
    numerosSorteados[3],
    numerosSorteados[4]

  ]);


  sheetSorteios
    .getRange(linhaSorteio, 9)
    .setValue('SORTEADO');


  // ==========================================================
  // PAGAR PRÉMIOS
  // ==========================================================

  let totalPremiosPagos = 0;


  for (
    let i = 0;
    i < jogadasDoSorteio.length;
    i++
  ) {

    const jogada =
      jogadasDoSorteio[i];


    const acertos =
      jogada.numeros.filter(
        function(n) {
          return numerosSorteados.includes(n);
        }
      ).length;


    if (
      acertos >= 1 &&
      PREMIOS[acertos]
    ) {

      const premio =
        PREMIOS[acertos];


      const premioId =
        'PRM-' +
        Utilities
          .getUuid()
          .substring(0, 8)
          .toUpperCase();


      sheetPremios.appendRow([

        premioId,

        sorteioId,

        jogada.usuarioId,

        acertos,

        premio,

        premio,

        'PAGO',

        new Date()

      ]);


      const dadosUsuarios =
        sheetUsuarios
          .getDataRange()
          .getValues();


      for (
        let u = 1;
        u < dadosUsuarios.length;
        u++
      ) {

        if (
          String(dadosUsuarios[u][0]) ===
          String(jogada.usuarioId)
        ) {

          const saldoAtual =
            Number(
              dadosUsuarios[u][4] || 0
            );


          sheetUsuarios
            .getRange(u + 1, 5)
            .setValue(
              saldoAtual + premio
            );

          break;
        }
      }


      sheetMovimentos.appendRow([

        'MOV-' +
        Utilities
          .getUuid()
          .substring(0, 8)
          .toUpperCase(),

        new Date(),

        jogada.usuarioId,

        'PREMIO',

        jogada.jogadaId,

        premio,

        'PAGO',

        premioId,

        'Sistema'

      ]);


      totalPremiosPagos += premio;


      sheetJogadas
        .getRange(jogada.linha, 9)
        .setValue(
          'GANHOU_' + acertos
        );

    } else {

      sheetJogadas
        .getRange(jogada.linha, 9)
        .setValue('PERDEU');
    }
  }


  // ==========================================================
  // ATUALIZAR COFRE
  // ==========================================================

  const premiosPagosAtual =
    Number(
      dadosSorteios[
        linhaSorteio - 1
      ][6] || 0
    );


  const saldoPremiosAtual =
    Number(
      dadosSorteios[
        linhaSorteio - 1
      ][7] || 0
    );


  sheetSorteios
    .getRange(linhaSorteio, 7)
    .setValue(
      premiosPagosAtual +
      totalPremiosPagos
    );


  sheetSorteios
    .getRange(linhaSorteio, 8)
    .setValue(
      saldoPremiosAtual -
      totalPremiosPagos
    );


  sheetSorteios
    .getRange(linhaSorteio, 9)
    .setValue('PAGO');


  SpreadsheetApp.flush();


  return {

    success: true,

    sorteioId: sorteioId,

    numeros: numerosSorteados,

    totalPremiosPagos:
      totalPremiosPagos,

    fundoPremios:
      fundoPremios
  };
}


// ============================================================
// GERAR COMBINAÇÃO ALEATÓRIA 1-55
// ============================================================

function gerarCombinacaoAleatoria() {

  const nums =
    new Set();


  while (nums.size < 5) {

    nums.add(
      Math.floor(
        Math.random() * 55
      ) + 1
    );
  }


  return [
    ...nums
  ].sort(
    function(a, b) {
      return a - b;
    }
  );
}


// ============================================================
// CALCULAR CUSTO DOS PRÉMIOS
// ============================================================

function calcularCustoPremios(
  numerosSorteados,
  jogadas
) {

  let custo = 0;


  for (
    let i = 0;
    i < jogadas.length;
    i++
  ) {

    const acertos =
      jogadas[i].numeros.filter(
        function(n) {
          return numerosSorteados.includes(n);
        }
      ).length;


    if (
      acertos >= 1 &&
      PREMIOS[acertos]
    ) {

      custo +=
        PREMIOS[acertos];
    }
  }


  return custo;
}


// ============================================================
// COMBINAÇÃO NÃO APOSTADA
// ============================================================

function gerarCombinacaoNaoApostada(
  todosNumerosApostados
) {

  const naoApostados = [];


  for (
    let n = 1;
    n <= 55;
    n++
  ) {

    if (
      !todosNumerosApostados.has(n)
    ) {

      naoApostados.push(n);
    }
  }


  if (naoApostados.length >= 5) {

    for (
      let i = naoApostados.length - 1;
      i > 0;
      i--
    ) {

      const j =
        Math.floor(
          Math.random() * (i + 1)
        );


      [
        naoApostados[i],
        naoApostados[j]
      ] = [
        naoApostados[j],
        naoApostados[i]
      ];
    }


    return naoApostados
      .slice(0, 5)
      .sort(
        function(a, b) {
          return a - b;
        }
      );
  }


  return gerarCombinacaoAleatoria();
}


// ============================================================
// SORTEIO CONDICIONADO
// ============================================================

function sorteioCondicionado(
  jogadas,
  fundoPremios,
  todosNumerosApostados
) {

  const TENTATIVAS = 3000;

  const validas = [];

  const custoZero = [];


  for (
    let t = 0;
    t < TENTATIVAS;
    t++
  ) {

    const nums =
      gerarCombinacaoAleatoria();


    const custo =
      calcularCustoPremios(
        nums,
        jogadas
      );


    if (custo === 0) {

      custoZero.push(nums);

    } else if (
      custo <= fundoPremios
    ) {

      validas.push({
        nums: nums,
        custo: custo
      });
    }
  }


  if (validas.length > 0) {

    const idx =
      Math.floor(
        Math.random() *
        validas.length
      );


    return validas[idx].nums;
  }


  if (custoZero.length > 0) {

    const idx =
      Math.floor(
        Math.random() *
        custoZero.length
      );


    return custoZero[idx];
  }


  return gerarCombinacaoNaoApostada(
    todosNumerosApostados
  );
}


