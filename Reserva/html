/* ==========================================================
   CONFIGURAÇÃO INICIAL
   ========================================================== */

function configurarSistema() {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.CONFIG
    );


  const valores = {

    JOGO: '5/55',

    VALOR_APOSTA: '10',

    MINUTOS_ABERTURA: '15',

    PERCENTUAL_CASA: '50',

    PERCENTUAL_PREMIOS: '50'

  };


  const existentes =
    sheet
      .getDataRange()
      .getValues();


  const mapa = {};


  for (
    let i = 1;
    i < existentes.length;
    i++
  ) {

    mapa[
      String(
        existentes[i][0]
      )
    ] = i + 1;

  }


  Object.keys(valores).forEach(chave => {

    if (mapa[chave]) {

      sheet
        .getRange(
          mapa[chave],
          2
        )
        .setValue(
          valores[chave]
        );

    } else {

      sheet.appendRow([
        chave,
        valores[chave]
      ]);

    }

  });

}


/* ==========================================================
   CRIAR SORTEIOS DO DIA
   ========================================================== */

function criarSorteiosDoDia() {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );


  const agora =
    new Date();


  const data =
    Utilities.formatDate(
      agora,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );


  /*
   * HORÁRIOS DOS SORTEIOS
   *
   * ALTERE AQUI OS HORÁRIOS.
   *
   * Exemplo:
   * 12:00
   * 15:00
   * 18:00
   * 21:00
   */

  const horarios = [
    '12:00',
    '15:00',
    '18:00',
    '21:00'
  ];


  const dados =
    sheet
      .getDataRange()
      .getValues();


  horarios.forEach(hora => {

    const id =
      'SMZ-' +
      data.replace(/-/g, '') +
      '-' +
      hora.replace(':', '');


    let existe = false;


    for (
      let i = 1;
      i < dados.length;
      i++
    ) {

      if (
        String(dados[i][0]) === id
      ) {

        existe = true;

        break;

      }

    }


    if (!existe) {

      const fechamento =
        calcularDataHora(
          data,
          hora
        );


      sheet.appendRow([

        id,

        data,

        hora,

        fechamento,

        'PROGRAMADO',

        0,

        0,

        0,

        0,

        ''

      ]);

    }

  });


  atualizarStatusSorteios();


  return {

    success: true

  };

}


/* ==========================================================
   ATUALIZAR STATUS DOS SORTEIOS
   ========================================================== */

function atualizarStatusSorteios() {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );


  const dados =
    sheet
      .getDataRange()
      .getValues();


  const agora =
    new Date();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    const data =
      String(dados[i][1] || '');

    const hora =
      String(dados[i][2] || '');

    if (!data || !hora) continue;


    const sorteio =
      calcularDataHora(
        data,
        hora
      );


    const abertura =
      new Date(
        sorteio.getTime() -
        CONFIG.MINUTOS_ABERTURA *
        60000
      );


    const fechamento =
      sorteio;


    let status =
      String(
        dados[i][4] || ''
      );


    /*
     * ABERTO:
     * desde 15 minutos antes
     * até à hora do sorteio.
     */

    if (
      agora >= abertura &&
      agora < fechamento
    ) {

      status = 'ABERTO';

    }

    else if (
      agora >= fechamento
    ) {

      if (
        status !== 'REALIZADO'
      ) {

        status = 'FECHADO';

      }

    }

    else {

      status = 'PROGRAMADO';

    }


    sheet
      .getRange(i + 1, 5)
      .setValue(status);

  }

}


/* ==========================================================
   OBTER SORTEIOS ABERTOS
   ========================================================== */

function obterSorteiosAbertos() {

  criarSorteiosDoDia();

  atualizarStatusSorteios();


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );


  const dados =
    sheet
      .getDataRange()
      .getValues();


  const agora =
    new Date();

  const lista = [];


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    const data =
      String(dados[i][1] || '');

    const hora =
      String(dados[i][2] || '');

    if (!data || !hora) continue;


    const sorteio =
      calcularDataHora(
        data,
        hora
      );


    const abertura =
      new Date(
        sorteio.getTime() -
        CONFIG.MINUTOS_ABERTURA *
        60000
      );


    /*
     * ESTA É A REGRA PRINCIPAL.
     *
     * Se já estamos nos 15 minutos
     * anteriores ao sorteio e ainda
     * não atingimos a hora:
     *
     * ABERTO.
     */

    if (
      agora >= abertura &&
      agora < sorteio
    ) {

      lista.push({

        id: dados[i][0],

        data: data,

        hora: hora,

        fechamento:
          formatarDataHora(
            sorteio
          ),

        status: 'ABERTO'

      });

    }

  }


  return {

    success: true,

    sorteios: lista

  };

}


/* ==========================================================
   REGISTAR UTILIZADOR
   ========================================================== */

function registarUsuario(
  nome,
  telefone
) {

  if (!nome)
    throw new Error(
      'Nome obrigatório.'
    );

  if (!telefone)
    throw new Error(
      'Telefone obrigatório.'
    );


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const dados =
    sheet
      .getDataRange()
      .getValues();


  const tel =
    normalizarTelefone(
      telefone
    );


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      normalizarTelefone(
        dados[i][3]
      ) === tel
    ) {

      return {

        success: true,

        existente: true,

        id: dados[i][0],

        referencia: dados[i][4],

        saldo:
          Number(
            dados[i][5]
          ) || 0

      };

    }

  }


  const id =
    'USR-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase();


  const referencia =
    gerarReferencia();


  sheet.appendRow([

    id,

    new Date(),

    nome,

    tel,

    referencia,

    0,

    'ATIVO'

  ]);


  return {

    success: true,

    existente: false,

    id: id,

    referencia: referencia,

    saldo: 0

  };

}


/* ==========================================================
   REFERÊNCIA DO CLIENTE
   ========================================================== */

function gerarReferencia() {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const numero =
    sheet.getLastRow();


  return (
    'SMZ' +
    String(
      numero
    ).padStart(6, '0')
  );

}


