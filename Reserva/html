/* ==========================================================
   CRIAR TRIGGER AUTOMÁTICO
   ========================================================== */

function instalarTriggers() {

  const triggers =
    ScriptApp
      .getProjectTriggers();


  triggers.forEach(
    trigger => {

      const nome =
        trigger
          .getHandlerFunction();


      if (
        nome ===
          'criarSorteiosDoDia' ||
        nome ===
          'atualizarStatusSorteios'
      ) {

        ScriptApp
          .deleteTrigger(
            trigger
          );

      }

    }
  );


  /*
   * A cada 5 minutos:
   * - cria os sorteios
   * - atualiza o estado
   */

  ScriptApp.newTrigger(
    'criarSorteiosDoDia'
  )
    .timeBased()
    .everyMinutes(5)
    .create();


  ScriptApp.newTrigger(
    'atualizarStatusSorteios'
  )
    .timeBased()
    .everyMinutes(5)
    .create();


  return {

    success: true,

    message:
      'Triggers instalados.'

  };

}
