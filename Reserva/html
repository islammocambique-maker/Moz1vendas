// ============================================================

function registarJogada(data) {

  if (!data.usuarioId) {

    throw new Error(
      'Usuário não informado.'
    );
  }


  if (!data.sorteioId) {

    throw new Error(
      'Sorteio não informado.'
    );
  }


  if (!data.numeros) {

    throw new Error(
      'Números não informados.'
    );
  }


  let numeros =
    data.numeros;


  if (
    typeof numeros ===
    'string'
  ) {

    numeros =
      numeros
        .split(',')
        .map(Number);
  }


  if (
    !Array.isArray(numeros) ||
    numeros.length !== 5
  ) {

    throw new Error(
      'Selecione exatamente 5 números.'
    );
  }


  const unicos =
    [...new Set(numeros)];


  if (
    unicos.length !== 5
  ) {

    throw new Error(
      'Números não podem repetir.'
    );
  }


  numeros.forEach(
    function(n) {

      if (
        n < 1 ||
        n > 55
      ) {

        throw new Error(
          'Números entre 1 e 55.'
        );
      }
    }
  );


  const sorteio =
    obterSorteioPorIdInterno(
      data.sorteioId
    );


  if (!sorteio) {

    throw new Error(
      'Sorteio não encontrado.'
    );
  }


  if (
    normalizarStatus(
      sorteio.status
    ) !== 'ABERTO'
  ) {

    throw new Error(
      'Sorteio fechado.'
    );
  }


  // Verificação adicional do horário
  const agora =
    new Date();


  const dataHoraSorteio =
    criarDataHora(
      sorteio.data,
      sorteio.hora
    );


  if (!dataHoraSorteio) {

    throw new Error(
      'Data ou hora do sorteio inválida.'
    );
  }


  const fechamento =
    new Date(
      dataHoraSorteio.getTime() -
      MINUTOS_FECHAMENTO_ANTES *
      60000
    );


  if (agora >= fechamento) {

    throw new Error(
      'As apostas para este sorteio já estão fechadas.'
    );
  }


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const sheetUsuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const dadosUsuarios =
    sheetUsuarios
      .getDataRange()
      .getValues();


  let linhaUsuario = -1;

  let saldoAtual = 0;


  for (
    let i = 1;
    i < dadosUsuarios.length;
    i++
  ) {

    if (
      String(
        dadosUsuarios[i][0]
      ) ===
      String(
        data.usuarioId
      )
    ) {

      linhaUsuario =
        i + 1;

      saldoAtual =
        Number(
          dadosUsuarios[i][4] || 0
        );

      break;
    }
  }


  if (
    linhaUsuario === -1
  ) {

    throw new Error(
      'Usuário não encontrado.'
    );
  }


  const valor =
    Number(
      data.valor || 10
    );


  if (
    saldoAtual < valor
  ) {

    throw new Error(
      'Saldo insuficiente.'
    );
  }


  const sheetJogadas =
    ss.getSheetByName(
      SHEETS.JOGADAS
    );


  const id =
    'JOG-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase();


  numeros =
    numeros.sort(
      function(a, b) {
        return a - b;
      }
    );


  sheetJogadas.appendRow([

    id,

    data.usuarioId,

    data.referencia || '',

    sorteio.id,

    new Date(),

    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      'HH:mm:ss'
    ),

    numeros.join(','),

    valor,

    'CONFIRMADA'
  ]);


  const novoSaldo =
    saldoAtual - valor;


  sheetUsuarios
    .getRange(
      linhaUsuario,
      5
    )
    .setValue(
      novoSaldo
    );


  const sheetMovimentos =
    ss.getSheetByName(
      SHEETS.MOVIMENTOS
    );


  sheetMovimentos.appendRow([

    'MOV-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase(),

    new Date(),

    data.usuarioId,

    'APOSTA',

    data.referencia || '',

    -valor,

    'CONFIRMADO',

    id,

    'Sistema'
  ]);


  atualizarCofre(
    sorteio.id,
    valor
  );


  SpreadsheetApp.flush();


  return {

    success: true,

    jogadaId:
      id,

    sorteioId:
      sorteio.id,

    numeros:
      numeros,

    saldoRestante:
      novoSaldo
  };
}


