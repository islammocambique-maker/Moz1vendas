function normalizarTelefone(tel) {
  if (!tel) return '';
  return String(tel).trim().replace(/\D/g, '');
}


function normalizarStatus(status) {
  return String(status || '').trim().toUpperCase();
}


function normalizarHora(hora) {
  if (!hora) return '';

  if (hora instanceof Date) {
    return Utilities.formatDate(
      hora,
      Session.getScriptTimeZone(),
      'HH:mm'
    );
  }

  let texto = String(hora).trim();

  // Caso venha como 10:00:00
  if (/^\d{1,2}:\d{2}:\d{2}$/.test(texto)) {
    texto = texto.substring(0, 5);
  }

  // Caso venha como 10:0
  const partes = texto.split(':');

  if (partes.length >= 2) {
    const hh = Number(partes[0]);
    const mm = Number(partes[1]);

    if (!isNaN(hh) && !isNaN(mm)) {
      return (
        String(hh).padStart(2, '0') +
        ':' +
        String(mm).padStart(2, '0')
      );
    }
  }

  return texto;
}


function dataParaString(data) {
  if (!data) return '';

  if (data instanceof Date && !isNaN(data.getTime())) {
    return Utilities.formatDate(
      data,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );
  }

  const texto = String(data).trim();

  // yyyy-MM-dd
  if (/^\d{4}-\d{2}-\d{2}$/.test(texto)) {
    return texto;
  }

  // dd/MM/yyyy
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(texto)) {
    const p = texto.split('/');
    return p[2] + '-' + p[1] + '-' + p[0];
  }

  // dd-MM-yyyy
  if (/^\d{2}-\d{2}-\d{4}$/.test(texto)) {
    const p = texto.split('-');
    return p[2] + '-' + p[1] + '-' + p[0];
  }

  const tentativa = new Date(texto);

  if (!isNaN(tentativa.getTime())) {
    return Utilities.formatDate(
      tentativa,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );
  }

  return texto;
}


function criarDataHora(data, hora) {
  const dataStr = dataParaString(data);
  const horaStr = normalizarHora(hora);

  if (!dataStr || !horaStr) return null;

  const partesData = dataStr.split('-');
  const partesHora = horaStr.split(':');

  if (partesData.length !== 3 || partesHora.length < 2) {
    return null;
  }

  const ano = Number(partesData[0]);
  const mes = Number(partesData[1]);
  const dia = Number(partesData[2]);

  const hh = Number(partesHora[0]);
  const mm = Number(partesHora[1]);

  if (
    isNaN(ano) ||
    isNaN(mes) ||
    isNaN(dia) ||
    isNaN(hh) ||
    isNaN(mm)
  ) {
    return null;
  }

  return new Date(
    ano,
    mes - 1,
    dia,
    hh,
    mm,
    0,
    0
  );
}


function dataHoje() {
  const agora = new Date();

  const texto = Utilities.formatDate(
    agora,
    Session.getScriptTimeZone(),
    'yyyy-MM-dd'
  );

  const p = texto.split('-');

  return new Date(
    Number(p[0]),
    Number(p[1]) - 1,
    Number(p[2]),
    0,
    0,
    0,
    0
  );
}


function json(obj) {
  return ContentService
