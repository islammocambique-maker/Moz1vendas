function solicitarLevantamento(
  data
) {

  if (!data.usuarioId) {

    throw new Error(
      'Usuário não informado.'
    );
  }


  if (
    !data.valor ||
    Number(data.valor) <= 0
  ) {

    throw new Error(
      'Valor obrigatório.'
    );
  }


  if (!data.telefone) {

    throw new Error(
      'Telefone M-Pesa obrigatório.'
    );
  }


  const valor =
    Number(data.valor);


  const taxa = 0;


  const valorLiquido =
    valor - taxa;


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const sheetUsuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const sheetLevantamentos =
    ss.getSheetByName(
      SHEETS.LEVANTAMENTOS
    );


  const dados =
    sheetUsuarios
      .getDataRange()
      .getValues();


  let linhaUsuario = -1;

  let saldoAtual = 0;


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(
        dados[i][0]
      ) ===
      String(
        data.usuarioId
      )
    ) {

      linhaUsuario =
        i + 1;

      saldoAtual =
        Number(
          dados[i][4] || 0
        );

      break;
    }
  }


  if (
    linhaUsuario === -1
  ) {

    throw new Error(
      'Usuário não encontrado.'
    );
  }


  if (
    saldoAtual < valor
  ) {

    throw new Error(
      'Saldo insuficiente para levantamento.'
    );
  }


  const novoSaldo =
    saldoAtual - valor;


  sheetUsuarios
    .getRange(
      linhaUsuario,
      5
    )
    .setValue(
      novoSaldo
    );


  const id =
    'LEV-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase();


  sheetLevantamentos.appendRow([

    id,

    new Date(),

    data.usuarioId,

    data.telefone,

    valor,

    taxa,

    valorLiquido,

    'PENDENTE',

    '',

    ''
  ]);


  const sheetMovimentos =
    ss.getSheetByName(
      SHEETS.MOVIMENTOS
    );


  sheetMovimentos.appendRow([

    'MOV-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase(),

    new Date(),

    data.usuarioId,

    'LEVANTAMENTO',

    id,

    -valor,

    'PENDENTE',

    id,

    'Sistema'
  ]);


  return {

    success: true,

    message:
      'Pedido de levantamento registado.',

    levantamentoId:
      id,

    valor:
      valor,

    valorLiquido:
      valorLiquido,

    novoSaldo:
      novoSaldo
  };
}


