function atualizarCofre(
  sorteioId,
  valor
) {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const sheet =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );


  const dados =
    sheet
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(
        dados[i][0]
      ).trim() ===
      String(
        sorteioId
      ).trim()
    ) {

      const arrecadacao =
        Number(
          dados[i][3] || 0
        ) +
        Number(valor);


      const casa =
        arrecadacao * 0.50;


      const fundo =
        arrecadacao * 0.50;


      const pagos =
        Number(
          dados[i][6] || 0
        );


      const saldo =
        fundo - pagos;


      sheet
        .getRange(
          i + 1,
          4
        )
        .setValue(
          arrecadacao
        );


      sheet
        .getRange(
          i + 1,
          5
        )
        .setValue(
          casa
        );


      sheet
        .getRange(
          i + 1,
          6
        )
        .setValue(
          fundo
        );


      sheet
        .getRange(
          i + 1,
          8
        )
        .setValue(
          saldo
        );


      break;
    }
  }
}


