/* ==========================================================
   REGISTAR JOGADA
   ========================================================== */

function registarJogada(
  usuarioId,
  referencia,
  sorteioId,
  numeros,
  valor
) {

  if (!usuarioId)
    throw new Error(
      'Utilizador obrigatório.'
    );


  if (!sorteioId)
    throw new Error(
      'Sorteio obrigatório.'
    );


  const nums =
    normalizarNumeros(
      numeros
    );


  if (nums.length !== 5)
    throw new Error(
      'Escolha exatamente 5 números.'
    );


  const valorAposta =
    Number(valor) ||
    CONFIG.VALOR_APOSTA;


  if (
    valorAposta !==
    CONFIG.VALOR_APOSTA
  ) {

    throw new Error(
      'Valor de aposta inválido.'
    );

  }


  /*
   * CONFIRMAR QUE O SORTEIO
   * ESTÁ REALMENTE ABERTO.
   *
   * Não confiamos no JS.
   */

  const sorteio =
    obterSorteioPorId(
      sorteioId
    );


  if (!sorteio)
    throw new Error(
      'Sorteio não encontrado.'
    );


  const agora =
    new Date();


  const dataHoraSorteio =
    calcularDataHora(
      sorteio.data,
      sorteio.hora
    );


  const abertura =
    new Date(
      dataHoraSorteio.getTime() -
      CONFIG.MINUTOS_ABERTURA *
      60000
    );


  if (
    agora < abertura ||
    agora >= dataHoraSorteio
  ) {

    throw new Error(
      'Este sorteio não está aberto.'
    );

  }


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const usuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );


  const jogadas =
    ss.getSheetByName(
      SHEETS.JOGADAS
    );


  const dados =
    usuarios
      .getDataRange()
      .getValues();


  let linhaUsuario = -1;


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(dados[i][0]) ===
      String(usuarioId)
    ) {

      linhaUsuario =
        i + 1;

      break;

    }

  }


  if (
    linhaUsuario === -1
  ) {

    throw new Error(
      'Utilizador não encontrado.'
    );

  }


  const saldo =
    Number(
      usuarios
        .getRange(
          linhaUsuario,
          6
        )
        .getValue()
    ) || 0;


  if (
    saldo < valorAposta
  ) {

    throw new Error(
      'Saldo insuficiente.'
    );

  }


  /*
   * DEBITAR SALDO
   */

  usuarios
    .getRange(
      linhaUsuario,
      6
    )
    .setValue(
      saldo -
      valorAposta
    );


  /*
   * REGISTAR APOSTA
   */

  const jogadaId =
    'JOG-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase();


  jogadas.appendRow([

    jogadaId,

    new Date(),

    usuarioId,

    referencia,

    sorteioId,

    nums.join(','),

    valorAposta,

    'CONFIRMADA',

    '',

    ''

  ]);


  /*
   * ATUALIZAR ARRECADAÇÃO
   */

  atualizarFinanceiroSorteio(
    sorteioId
  );


  return {

    success: true,

    jogadaId: jogadaId,

    sorteioId: sorteioId,

    saldoRestante:
      saldo -
      valorAposta

  };

}


/* ==========================================================
   ATUALIZAR FINANCEIRO DO SORTEIO
   ========================================================== */

function atualizarFinanceiroSorteio(
  sorteioId
) {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const sorteios =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );

  const jogadas =
    ss.getSheetByName(
      SHEETS.JOGADAS
    );


  const dados =
    jogadas
      .getDataRange()
      .getValues();


  let total = 0;

  let quantidade = 0;


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(dados[i][4]) ===
      String(sorteioId) &&
      String(dados[i][7]) ===
      'CONFIRMADA'
    ) {

      total +=
        Number(
          dados[i][6]
        ) || 0;

      quantidade++;

    }

  }


  const casa =
    total *
    CONFIG.PERCENTUAL_CASA;


  const premios =
    total *
    CONFIG.PERCENTUAL_PREMIOS;


  const dadosSorteios =
    sorteios
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dadosSorteios.length;
    i++
  ) {

    if (
      String(dadosSorteios[i][0]) ===
      String(sorteioId)
    ) {

      sorteios
        .getRange(
          i + 1,
          6,
          1,
          4
        )
        .setValues([[
          quantidade,
          total,
          casa,
          premios
        ]]);

      break;

    }

  }

}


/* ==========================================================
   OBTER SORTEIO POR ID
   ========================================================== */

function obterSorteioPorId(
  id
) {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );

  const sheet =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );


  const dados =
    sheet
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(dados[i][0]) ===
      String(id)
    ) {

      return {

        linha: i + 1,

        id: dados[i][0],

        data: dados[i][1],

        hora: dados[i][2],

        fechamento:
          dados[i][3],

        status:
          dados[i][4]

      };

    }

  }


  return null;

}


/* ==========================================================
   APURAR SORTEIO
   ========================================================== */

function apurarSorteio(
  sorteioId
) {

  const sorteio =
    obterSorteioPorId(
      sorteioId
    );


  if (!sorteio)
    throw new Error(
      'Sorteio não encontrado.'
    );


  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const sorteios =
    ss.getSheetByName(
      SHEETS.SORTEIOS
    );

  const jogadas =
    ss.getSheetByName(
      SHEETS.JOGADAS
    );

  const resultados =
    ss.getSheetByName(
      SHEETS.RESULTADOS
    );


  /*
   * GERAR 5 NÚMEROS ÚNICOS
   */

  const numeros = [];


  while (
    numeros.length < 5
  ) {

    const n =
      Math.floor(
        Math.random() *
        55
      ) + 1;


    if (
      !numeros.includes(n)
    ) {

      numeros.push(n);

    }

  }


  numeros.sort(
    (a, b) => a - b
  );


  const resultadoId =
    'RES-' +
    Utilities
      .getUuid()
      .substring(0, 8)
      .toUpperCase();


  resultados.appendRow([

    resultadoId,

    sorteioId,

    sorteio.data,

    sorteio.hora,

    numeros.join(',')

  ]);


  /*
   * CALCULAR FUNDO DE PRÉMIOS
   */

  atualizarFinanceiroSorteio(
    sorteioId
  );


  const dadosSorteio =
    sorteios
      .getRange(
        sorteio.linha,
        1,
        1,
        10
      )
      .getValues()[0];


  const fundoPremios =
    Number(
      dadosSorteio[8]
    ) || 0;


  /*
   * PROCURAR APOSTAS
   */

  const dadosJogadas =
    jogadas
      .getDataRange()
      .getValues();


  const vencedores = [];


  for (
    let i = 1;
    i < dadosJogadas.length;
    i++
  ) {

    if (
      String(dadosJogadas[i][4]) !==
      String(sorteioId)
    ) continue;


    if (
      String(dadosJogadas[i][7]) !==
      'CONFIRMADA'
    ) continue;


    const apostados =
      normalizarNumeros(
        dadosJogadas[i][5]
      );


    const acertos =
      apostados.filter(
        n =>
          numeros.includes(n)
      ).length;


    if (
      acertos >= 3
    ) {

      vencedores.push({

        linha: i + 1,

        usuarioId:
          dadosJogadas[i][2],

        jogadaId:
          dadosJogadas[i][0],

        acertos: acertos

      });

    }


    jogadas
      .getRange(
        i + 1,
        9
      )
      .setValue(
        acertos
      );

  }


  /*
   * DISTRIBUIÇÃO DO FUNDO
   *
   * O fundo de 50% é distribuído
   * igualmente entre as apostas
   * vencedoras.
   */

  if (
    vencedores.length > 0 &&
    fundoPremios > 0
  ) {

    const premioIndividual =
      fundoPremios /
      vencedores.length;


    vencedores.forEach(v => {

      creditarPremio(
        v.usuarioId,
        v.jogadaId,
        sorteioId,
        v.acertos,
        premioIndividual
      );


      jogadas
        .getRange(
          v.linha,
          10
        )
        .setValue(
          premioIndividual
        );

    });

  }


  /*
   * MARCAR SORTEIO
   */

  sorteios
    .getRange(
      sorteio.linha,
      5
    )
    .setValue(
      'REALIZADO'
    );


  sorteios
    .getRange(
      sorteio.linha,
      10
    )
    .setValue(
      numeros.join(',')
    );


  return {

    success: true,

    sorteioId: sorteioId,

    numeros: numeros,

    fundoPremios: fundoPremios,

    vencedores:
      vencedores.length

  };

}


/* ==========================================================
   CREDITAR PRÉMIO
   ========================================================== */

function creditarPremio(
  usuarioId,
  jogadaId,
  sorteioId,
  acertos,
  valor
) {

  const ss =
    SpreadsheetApp.openById(
      SPREADSHEET_ID
    );


  const usuarios =
    ss.getSheetByName(
      SHEETS.USUARIOS
    );

  const premios =
    ss.getSheetByName(
      SHEETS.PREMIOS
    );

  const movimentos =
    ss.getSheetByName(
      SHEETS.MOVIMENTOS
    );


  const dados =
    usuarios
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(dados[i][0]) !==
      String(usuarioId)
    ) continue;


    const saldo =
      Number(
        dados[i][5]
      ) || 0;


    usuarios
      .getRange(
        i + 1,
        6
      )
      .setValue(
        saldo +
        valor
      );


    const premioId =
      'PRE-' +
      Utilities
        .getUuid()
        .substring(0, 8)
        .toUpperCase();


    premios.appendRow([

      premioId,

      new Date(),

      usuarioId,

      jogadaId,

      sorteioId,

      acertos,

      valor,

      'CREDITADO'

    ]);


    movimentos.appendRow([

      'MOV-' +
      Utilities
        .getUuid()
        .substring(0, 8)
        .toUpperCase(),

      new Date(),

      usuarioId,

      'PREMIO',

      '',

      valor,

      'CONFIRMADO',

      premioId,

      'SORTEIO'

    ]);


    return true;

  }


  return false;

}


