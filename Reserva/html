// ============================================================
// CRIAÇÃO DAS ABAS
// ============================================================

function criarAba(ss, nome, cabecalho) {

  let sheet = ss.getSheetByName(nome);

  if (!sheet) {

    sheet = ss.insertSheet(nome);

    sheet
      .getRange(1, 1, 1, cabecalho.length)
      .setValues([cabecalho]);

    sheet.setFrozenRows(1);
  }
}


// ============================================================
// TRIGGERS
// ============================================================

function instalarTriggers() {

  const triggers = ScriptApp.getProjectTriggers();

  triggers.forEach(function(trigger) {

    const funcao = trigger.getHandlerFunction();

    if (
      funcao === 'triggerDiarioSorteios' ||
      funcao === 'triggerFecharSorteios' ||
      funcao === 'triggerSorteioAutomatico'
    ) {
      ScriptApp.deleteTrigger(trigger);
    }

  });


  // Todos os dias de madrugada cria os sorteios
  ScriptApp.newTrigger('triggerDiarioSorteios')
    .timeBased()
    .everyDays(1)
    .atHour(0)
    .create();


  // Verifica fechamento a cada 5 minutos
  ScriptApp.newTrigger('triggerFecharSorteios')
    .timeBased()
    .everyMinutes(5)
    .create();


  // Verifica sorteios a cada 5 minutos
  ScriptApp.newTrigger('triggerSorteioAutomatico')
    .timeBased()
    .everyMinutes(5)
    .create();


  Logger.log('Triggers instalados com sucesso.');
}


