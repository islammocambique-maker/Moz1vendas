    );


  const dados =
    usuarios
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (
      String(dados[i][0]) !==
      String(usuarioId)
    ) continue;


    const saldo =
      Number(
        dados[i][5]
      ) || 0;


    if (
      saldo < valor
    ) {

